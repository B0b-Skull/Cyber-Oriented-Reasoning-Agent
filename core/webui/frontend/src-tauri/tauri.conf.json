{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CORA Cyber Oriented Reasoning Agent",
  "version": "5.15.12",
  "identifier": "com.crowinnovations.cora.webui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1337",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "C.O.R.A. — Cyber Oriented Reasoning Agent Dashboard",
        "width": 1520,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
